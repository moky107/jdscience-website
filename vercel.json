{
  "functions": {
    "api/education-posts.js": {
      "includeFiles": "content/shop/**"
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "jdscience.co.uk" }],
      "destination": "https://www.jdscience.co.uk/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/resource-file", "destination": "/api/education-posts?kind=file" },
    { "source": "/api/shop-products", "destination": "/api/education-posts?kind=shop-products" },
    { "source": "/api/shop-order", "destination": "/api/education-posts?kind=shop-order" },
    { "source": "/api/shop-download", "destination": "/api/education-posts?kind=shop-download" },
    { "source": "/api/create-shop-checkout-session", "destination": "/api/create-checkout-session?checkout=shop" },
    { "source": "/api/admin-shop-products", "destination": "/api/admin-education-posts?scope=shop" },
    { "source": "/api/admin-shop-orders", "destination": "/api/admin-education-posts?scope=shop-orders" },
    { "source": "/papers", "destination": "/" },
    { "source": "/papers/", "destination": "/" },
    { "source": "/tutors", "destination": "/" },
    { "source": "/tutors/", "destination": "/" },
    { "source": "/shop", "destination": "/" },
    { "source": "/shop/", "destination": "/" },
    { "source": "/shop/:slug", "destination": "/" },
    { "source": "/shop/:slug/", "destination": "/" },
    { "source": "/((?!api/|resources/|worksheets/|about/|terms/|tutors/joseph-danso|sitemap\\.xml|robots\\.txt|llms\\.txt|site\\.webmanifest|og-image\\.png|favicon\\.svg).*)", "destination": "/" }
  ]
}
