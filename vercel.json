{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "jdscience.co.uk" }],
      "destination": "https://www.jdscience.co.uk/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/resource-file", "destination": "/api/education-posts?kind=file" },
    { "source": "/papers", "destination": "/" },
    { "source": "/papers/", "destination": "/" },
    { "source": "/tutors", "destination": "/" },
    { "source": "/tutors/", "destination": "/" },
    { "source": "/((?!api/|resources/|worksheets/|about/|terms/|tutors/joseph-danso|sitemap\\.xml|robots\\.txt|llms\\.txt|site\\.webmanifest|og-image\\.png|favicon\\.svg).*)", "destination": "/" }
  ]
}
