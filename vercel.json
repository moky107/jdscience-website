{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "jdscience.co.uk" }],
      "destination": "https://www.jdscience.co.uk/:path*",
      "statusCode": 308
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self), usb=(), interest-cohort=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://*.supabase.co https://checkout.stripe.com https://hooks.stripe.com; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co; font-src 'self' data:; media-src 'self' https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.stripe.com; frame-src 'self' https://share.synthesia.io https://www.youtube-nocookie.com https://js.stripe.com https://hooks.stripe.com https://checkout.stripe.com; worker-src 'self' blob:; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/resource-file", "destination": "/api/education-posts?kind=file" },
    { "source": "/papers", "destination": "/" },
    { "source": "/papers/", "destination": "/" },
    { "source": "/tutors", "destination": "/" },
    { "source": "/tutors/", "destination": "/" },
    { "source": "/auth/callback", "destination": "/" },
    { "source": "/auth/callback/", "destination": "/" },
    { "source": "/((?!api/|resources/|worksheets/|about/|terms/|tutors/joseph-danso|sitemap\\.xml|robots\\.txt|llms\\.txt|site\\.webmanifest|og-image\\.png|favicon\\.svg).*)", "destination": "/" }
  ]
}
