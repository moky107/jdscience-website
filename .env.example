# =============================================================================
# JD Science — Environment Variables
# =============================================================================
# Copy this file to `.env` for local development, and set the SAME variables in
# your Vercel project: Settings -> Environment Variables (Production + Preview).
#
# IMPORTANT: After adding or changing any variable in Vercel you MUST trigger a
# new deployment (Deployments -> Redeploy). Existing deployments do NOT pick up
# env var changes automatically — this is the most common cause of the Stripe
# "You did not provide an API key" error.
# =============================================================================

# --- Stripe (server-side, used by /api serverless functions) ---
# Secret key from https://dashboard.stripe.com/apikeys  (starts with sk_test_ / sk_live_)
STRIPE_SECRET_KEY=

# Signing secret for your webhook endpoint (starts with whsec_)
# Get it from Stripe -> Developers -> Webhooks -> your endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET=

# --- Site URL (used to build Stripe success/cancel redirect URLs) ---
# e.g. https://jdscience.co.uk  (no trailing slash)
# Optional: if omitted, the checkout function falls back to the request host.
SITE_URL=

# --- Supabase (server-side, used by /api/webhook.js to insert bookings) ---
# Project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Service role key (SECRET — server only, never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# --- Email notifications (owner alerts for bookings and tutor applications) ---
# API key from https://resend.com/api-keys (starts with re_). If omitted,
# bookings and tutor applications still save — the email is simply skipped.
# Add this in Vercel → Settings → Environment Variables (Production + Preview),
# then Redeploy. Sign up to Resend with jd943791@gmail.com so the free tier
# can deliver to that inbox without verifying a domain.
#
# Important: Resend's shared onboarding sender (onboarding@resend.dev) can only
# deliver to the email address on the Resend account. If NOTIFY_EMAIL differs,
# verify a custom domain and set NOTIFY_FROM, or notifications will fail.
RESEND_API_KEY=

# Where booking and tutor-application alerts are sent.
# Defaults to jd943791@gmail.com if omitted.
NOTIFY_EMAIL=jd943791@gmail.com

# Optional custom "from" address. Defaults to Resend's shared onboarding
# sender, which works without verifying a domain. To send from your own
# domain (e.g. bookings@jdscience.co.uk) verify it in Resend first.
NOTIFY_FROM=

# --- Admin dashboard (view/manage bookings at /?admin=1) ---
# The password you type to open the bookings dashboard. Choose something
# strong; it is the only thing protecting the dashboard.
ADMIN_PASSWORD=

# --- Shop (optional until migration is applied) ---
# Run supabase/migrations/20260829_shop.sql in Supabase, then create a
# Storage bucket named shop-products (private). Product images, previews and
# digital downloads are stored under images/, previews/ and downloads/.
# Also run 20260830_shop_source_resource.sql so Copy to Shop can link
# shop_products.source_resource_id back to free resources without duplicates.
# Shop checkout reuses STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, SITE_URL,
# NEXT_PUBLIC_SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY and RESEND_API_KEY.

# Visitor registration uses Supabase Auth. Enable "Confirm email" in the
# Supabase dashboard and add https://www.jdscience.co.uk/?verified=1 to
# Authentication → URL Configuration → Redirect URLs.

# --- Frontend (Vite) — OPTIONAL overrides ---
# The public Supabase URL + anon key are safe to expose in the browser.
# These are optional: sensible defaults are hard-coded in src/supabaseClient.js.
# If set, they override the defaults. Vite requires the VITE_ prefix.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
