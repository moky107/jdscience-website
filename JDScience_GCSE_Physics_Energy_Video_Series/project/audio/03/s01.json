{"signature": "{\"model\": \"eleven_multilingual_v2\", \"provider\": \"elevenlabs\", \"settings\": {\"similarity_boost\": 0.85, \"stability\": 0.5, \"style\": 0.0, \"use_speaker_boost\": true}, \"text\": \"Kinetic energy is the energy stored by an object because it is moving. The equation is kinetic energy equals one half multiplied by mass multiplied by speed squared. In symbols, E sub k equals one half m v squared. The mass must be in kilograms, the speed in metres per second and the energy in joules. In this equation, v represents speed, although you may hear it called velocity in some explanations.\", \"voice\": \"28e9d9dcea90e5b4\"}", "duration": 29.675102, "words": [["Kinetic", 0.0], ["energy", 0.627], ["is", 1.115], ["the", 1.277], ["energy", 1.44], ["stored", 1.985], ["by", 2.403], ["an", 2.612], ["object", 2.763], ["because", 3.297], ["it", 3.704], ["is", 3.855], ["moving.", 4.04], ["The", 4.598], ["equation", 4.795], ["is", 5.399], ["kinetic", 5.584], ["energy", 6.153], ["equals", 6.769], ["one", 7.384], ["half", 7.709], ["multiplied", 8.011], ["by", 8.696], ["mass", 8.986], ["multiplied", 9.451], ["by", 10.112], ["speed", 10.403], ["squared.", 10.902], ["In", 11.564], ["symbols,", 11.807], ["E", 12.574], ["sub", 12.841], ["k", 13.177], ["equals", 13.433], ["one", 14.013], ["half", 14.35], ["m", 14.803], ["v", 15.047], ["squared.", 15.325], ["The", 16.033], ["mass", 16.254], ["must", 16.66], ["be", 16.951], ["in", 17.125], ["kilograms,", 17.299], ["the", 18.193], ["speed", 18.356], ["in", 18.727], ["metres", 18.878], ["per", 19.424], ["second", 19.656], ["and", 20.19], ["the", 20.399], ["energy", 20.538], ["in", 21.084], ["joules.", 21.27], ["In", 22.291], ["this", 22.512], ["equation,", 22.779], ["v", 23.58], ["represents", 24.137], ["speed,", 24.822], ["although", 25.577], ["you", 26.065], ["may", 26.216], ["hear", 26.448], ["it", 26.738], ["called", 26.901], ["velocity", 27.226], ["in", 27.98], ["some", 28.189], ["explanations.", 28.445]], "raw": [{"tex