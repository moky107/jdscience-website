{"signature": "{\"model\": \"eleven_multilingual_v2\", \"provider\": \"elevenlabs\", \"settings\": {\"similarity_boost\": 0.85, \"stability\": 0.5, \"style\": 0.0, \"use_speaker_boost\": true}, \"text\": \"For calculations, first square the speed, then multiply by the mass and finally divide by two. Consider a car with a mass of 1,200 kilograms travelling at 20 metres per second. Twenty squared is 400. Multiply 400 by 1,200 to obtain 480,000. Half of that is 240,000 joules, or 240 kilojoules. This is the car's kinetic energy.\", \"voice\": \"28e9d9dcea90e5b4\"}", "duration": 27.533061, "words": [["For", 0.0], ["calculations,", 0.279], ["first", 1.428], ["square", 1.741], ["the", 2.101], ["speed,", 2.241], ["then", 2.914], ["multiply", 3.204], ["by", 3.831], ["the", 4.005], ["mass", 4.145], ["and", 4.621], ["finally", 4.888], ["divide", 5.375], ["by", 5.77], ["two.", 5.968], ["Consider", 6.56], ["a", 7.187], ["car", 7.314], ["with", 7.651], ["a", 7.848], ["mass", 7.976], ["of", 8.324], ["1,200", 8.533], ["kilograms", 9.392], ["travelling", 10.612], ["at", 11.169], ["20", 11.343], ["metres", 11.714], ["per", 12.063], ["second.", 12.225], ["Twenty", 12.91], ["squared", 13.351], ["is", 13.897], ["400.", 14.153], ["Multiply", 15.139], ["400", 15.824], ["by", 16.114], ["1,200", 16.892], ["to", 17.508], ["obtain", 17.728], ["480,000.", 18.936], ["Half", 20.689], ["of", 21.002], ["that", 21.118], ["is", 21.362], ["240,000", 21.513], ["joules,", 22.082], ["or", 23.452], ["240", 23.672], ["kilojoules.", 24.52], ["This", 25.402], ["is", 25.658], ["the", 25.797], ["car's", 25.936], ["kinetic", 26.285], ["energy.", 26.819]], "raw": [{"text": "For", "start": 0.0, "end": 0.209}, {"text": "calculations,", "start": 0.279, "end": 1.219}, {"text": "first", "start": 1.428, "end": 1.707}, {"text": "square", "start": 1.741, "end": 2.067}, {"text": "the", "start": 2.101, "end": 2.183}, {"text": "speed,", "start": 2.241, "end": 2.798}, {"text": "then", "start": 2.914, "end": 3.123}, {"text