{"signature": "{\"model\": \"eleven_multilingual_v2\", \"provider\": \"elevenlabs\", \"settings\": {\"similarity_boost\": 0.85, \"stability\": 0.5, \"style\": 0.0, \"use_speaker_boost\": true}, \"text\": \"The most important feature of the equation is the square on the speed. If an object's speed doubles while its mass remains constant, its kinetic energy becomes four times as large. If its speed triples, its kinetic energy becomes nine times as large. By contrast, doubling the mass at the same speed only doubles the kinetic energy. This explains why an increase in road speed can produce a disproportionately large increase in the energy that must be transferred when a vehicle stops.\", \"voice\": \"28e9d9dcea90e5b4\"}", "duration": 32.20898, "words": [["The", 0.0], ["most", 0.232], ["important", 0.499], ["feature", 1.022], ["of", 1.44], ["the", 1.544], ["equation", 1.672], ["is", 2.252], ["the", 2.473], ["square", 2.624], ["on", 3.042], ["the", 3.181], ["speed.", 3.32], ["If", 4.226], ["an", 4.458], ["object's", 4.632], ["speed", 5.201], ["doubles", 5.584], ["while", 6.107], ["its", 6.397], ["mass", 6.618], ["remains", 6.931], ["constant,", 7.372], ["its", 8.371], ["kinetic", 8.638], ["energy", 9.183], ["becomes", 9.66], ["four", 10.136], ["times", 10.414], ["as", 10.797], ["large.", 10.995], ["If", 11.981], ["its", 12.214], ["speed", 12.376], ["triples,", 12.725], ["its", 13.7], ["kinetic", 13.944], ["energy", 14.489], ["becomes", 14.977], ["nine", 15.487], ["times", 15.766], ["as", 16.103], ["large.", 16.265], ["By", 17.392], ["contrast,", 17.659], ["doubling", 18.471], ["the", 18.982], ["mass", 19.121], ["at", 19.505], ["the", 19.679], ["same", 19.818], ["speed", 20.131], ["only", 20.712], ["doubles", 21.2], ["the", 21.641], ["kinetic", 21.78], ["energy.", 22.337], ["This", 23.394], ["explains", 23.684], ["why", 24.16], ["an", 24.392], ["increase", 24.543], ["in", 25.066], ["road", 25.228], ["speed", 25.472], ["can", 26.041], ["produce", 26.308], ["a", 26.772], [