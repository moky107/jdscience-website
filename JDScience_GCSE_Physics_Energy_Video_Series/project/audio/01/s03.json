{"signature": "{\"model\": \"eleven_multilingual_v2\", \"provider\": \"elevenlabs\", \"settings\": {\"similarity_boost\": 0.85, \"stability\": 0.5, \"style\": 0.0, \"use_speaker_boost\": true}, \"text\": \"Consider a battery-powered toy car. The battery's chemical energy store decreases. Energy is transferred electrically to the motor, then mechanically to the moving car, increasing its kinetic energy store. Some energy is also transferred to the internal energy stores of the motor and surroundings, and some is carried away by sound. The energy has not disappeared: it has been transferred to other stores.\", \"voice\": \"28e9d9dcea90e5b4\"}", "duration": 29.074286, "words": [["Consider", 0.0], ["a", 0.755], ["battery-powered", 0.952], ["toy", 1.858], ["car.", 2.159], ["The", 3.042], ["battery's", 3.239], ["chemical", 3.808], ["energy", 4.4], ["store", 4.841], ["decreases.", 5.224], ["Energy", 6.235], ["is", 6.722], ["transferred", 6.885], ["electrically", 7.663], ["to", 8.359], ["the", 8.51], ["motor,", 8.638], ["then", 9.543], ["mechanically", 9.834], ["to", 10.786], ["the", 10.995], ["moving", 11.122], ["car,", 11.517], ["increasing", 12.318], ["its", 13.119], ["kinetic", 13.317], ["energy", 13.909], ["store.", 14.35], ["Some", 15.279], ["energy", 15.65], ["is", 16.126], ["also", 16.324], ["transferred", 16.811], ["to", 17.484], ["the", 17.682], ["internal", 17.879], ["energy", 18.552], ["stores", 19.017], ["of", 19.493], ["the", 19.69], ["motor", 19.853], ["and", 20.468], ["surroundings,", 20.77], ["and", 21.78], ["some", 22.047], ["is", 22.36], ["carried", 22.511], ["away", 22.895], ["by", 23.231], ["sound.", 23.51], ["The", 24.23], ["energy", 24.45], ["has", 24.868], ["not", 25.077], ["disappeared:", 25.275], ["it", 26.203], ["has", 26.424], ["been", 26.668], ["transferred", 26.923], ["to", 27.597], ["other", 27.852], ["stores.", 28.27]], "raw": [{"text": "Consider", "start": 0.0, "end": 0.639}, {"text": "a", "start": 0.755, "end": 0.836}, {"text": "battery-pow