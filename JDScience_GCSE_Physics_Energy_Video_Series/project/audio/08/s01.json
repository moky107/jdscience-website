{"signature": "{\"model\": \"eleven_multilingual_v2\", \"provider\": \"elevenlabs\", \"settings\": {\"similarity_boost\": 0.85, \"stability\": 0.5, \"style\": 0.0, \"use_speaker_boost\": true}, \"text\": \"Thermal conductivity describes how readily a material conducts thermal energy. Its SI unit is watts per metre per kelvin, written W per metre per kelvin. A temperature difference of one kelvin is equal in size to a difference of one degree Celsius, so some tables express the unit using degrees Celsius. The lower the thermal conductivity, the more effective the material is at resisting conduction when thickness and other conditions are the same.\", \"voice\": \"28e9d9dcea90e5b4\"}", "duration": 30.772245, "words": [["Thermal", 0.0], ["conductivity", 0.488], ["describes", 1.289], ["how", 1.962], ["readily", 2.252], ["a", 2.763], ["material", 2.879], ["conducts", 3.553], ["thermal", 4.087], ["energy.", 4.54], ["Its", 5.236], ["SI", 5.712], ["unit", 6.153], ["is", 6.502], ["watts", 6.745], ["per", 7.488], ["metre", 7.767], ["per", 8.127], ["kelvin,", 8.336], ["written", 9.334], ["W", 9.764], ["per", 10.077], ["metre", 10.286], ["per", 10.6], ["kelvin.", 10.786], ["A", 11.854], ["temperature", 12.028], ["difference", 12.562], ["of", 13.015], ["one", 13.247], ["kelvin", 13.479], ["is", 14.013], ["equal", 14.28], ["in", 14.698], ["size", 14.896], ["to", 15.372], ["a", 15.604], ["difference", 15.685], ["of", 16.15], ["one", 16.347], ["degree", 16.556], ["Celsius,", 16.939], ["so", 17.856], ["some", 18.112], ["tables", 18.39], ["express", 18.959], ["the", 19.609], ["unit", 19.807], ["using", 20.167], ["degrees", 20.55], ["Celsius.", 20.991], ["The", 21.827], ["lower", 22.036], ["the", 22.477], ["thermal", 22.651], ["conductivity,", 23.069], ["the", 24.149], ["more", 24.323], ["effective", 24.544], ["the", 25.043], ["material", 25.159], ["is", 25.774], ["at", 26.157], ["resisting", 26.413], ["conduction", 26.97], ["when", 27.818], ["thickness", 28.096], ["and", 28.712], ["o